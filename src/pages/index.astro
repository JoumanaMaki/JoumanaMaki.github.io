---
const research = [
  {
    title: "Hierarchical Few-Shot Insect Classification",
    category: "Computer Vision · Master's Thesis",
    description:
      "Exploring hyperbolic representations and hierarchical learning for fine-grained insect recognition.",
    number: "01",
  },
  {
    title: "Optimization in Hyperbolic Neural Networks",
    category: "Geometric Deep Learning",
    description:
      "Investigating optimization methods and representations in non-Euclidean neural networks.",
    number: "02",
  },
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta
      name="description"
      content="Joumana Makki — Computer Vision and Machine Learning Researcher"
    />

    <title>Joumana Makki | AI Researcher</title>
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />

    <style is:global>
      /* =========================
         COLORS & GLOBAL STYLES
      ========================= */

      :root {
        --paper: #FAF8F5;
        --ink: #24242B;
        --accent: #74374F;
        --muted: #706B70;
        --border: #e7e0df;
      }

      * {
        box-sizing: border-box;
      }
	  /* Back to Top Button */
		.back-to-top {
		position: fixed;
		bottom: 30px;
		right: 30px;

		width: 48px;
		height: 48px;

		background: #74374F;
		color: white;

		border-radius: 50%;

		display: flex;
		align-items: center;
		justify-content: center;

		font-size: 24px;
		text-decoration: none;

		box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
		z-index: 1000;

		transition: transform 0.3s ease, background 0.3s ease;
		}

		.back-to-top:hover {
		background: #592638;
		transform: translateY(-4px);
		}

		@media (max-width: 650px) {
		.back-to-top {
			bottom: 20px;
			right: 20px;
			width: 42px;
			height: 42px;
		}
		}

		@media (prefers-reduced-motion: reduce) {
		.back-to-top {
			transition: none;
		}
		}

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: "DM Sans", sans-serif;
        line-height: 1.6;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      a:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 4px;
      }

      .container {
        width: min(1100px, 90%);
        margin: 0 auto;
      }

      /* =========================
         NAVIGATION
      ========================= */

      header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 25px;
        padding: 28px 0;
        border-bottom: 1px solid var(--border);
      }

      .logo {
        font-size: 17px;
        font-weight: 700;
        letter-spacing: -0.04em;
      }

      nav {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 25px;
      }

      nav a {
        font-size: 13px;
        font-weight: 500;
        transition: color 0.2s ease;
      }

      nav a:hover,
      .text-link:hover {
        color: var(--accent);
      }

      /* =========================
         TYPOGRAPHY
      ========================= */

      .eyebrow {
        color: var(--accent);
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      h1,
      h2,
      h3 {
        font-family: "Instrument Serif", Georgia, serif;
        font-weight: 400;
        line-height: 1.1;
      }

      h2 {
        font-size: clamp(40px, 5vw, 62px);
        margin: 15px 0 35px;
      }

      h3 {
        font-size: 32px;
        margin: 12px 0;
      }

      p {
        color: var(--muted);
      }

      /* =========================
         HERO SECTION
      ========================= */

      .hero {
        display: grid;
        grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
        align-items: center;
        gap: 55px;
        padding: 95px 0 110px;
      }

      .hero-content {
        min-width: 0;
      }

      .hero h1 {
        font-size: clamp(42px, 4.5vw, 66px);
        line-height: 1.12;
        letter-spacing: -0.035em;
        margin: 25px 0;
      }

      .hero h1 em {
        color: var(--accent);
        font-weight: 400;
      }

      .intro {
        font-size: 17px;
        line-height: 1.8;
        max-width: 570px;
      }

      /* Buttons */

      .actions {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 22px;
        margin-top: 35px;
      }

      .button {
        display: inline-block;
        padding: 13px 22px;
        border-radius: 6px;
        background: var(--accent);
        color: white;
        font-size: 14px;
        font-weight: 500;
        transition:
          background 0.2s ease,
          transform 0.2s ease;
      }

      .button:hover {
        background: #592638;
        transform: translateY(-2px);
      }

      .text-link {
        font-size: 14px;
        font-weight: 600;
        transition: color 0.2s ease;
      }

      /* =========================
         PROFILE PHOTO
      ========================= */

      .hero-image {
        width: 100%;
        max-width: 370px;
        justify-self: end;
      }

      .hero-image img {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 3 / 4;
        object-fit: cover;
        object-position: center 70%;
        border-radius: 18px;
        box-shadow:
          0 18px 45px rgba(36, 36, 43, 0.12);
      }

      /* =========================
         GENERAL SECTIONS
      ========================= */

      section:not(.hero) {
        padding: 75px 0;
      }

      /* =========================
         RESEARCH
      ========================= */

      .cards {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 25px;
      }

      .card {
        border: 1px solid var(--border);
        padding: 30px;
        border-radius: 10px;
        background: #fffdfb;
        transition:
          transform 0.2s ease,
          box-shadow 0.2s ease;
      }

      .card:hover {
        transform: translateY(-4px);
        box-shadow:
          0 12px 30px rgba(36, 36, 43, 0.06);
      }

      .card-number {
        color: var(--accent);
        font-size: 12px;
        font-weight: 600;
      }

      .card p {
        font-size: 15px;
        line-height: 1.8;
      }

      /* =========================
         ABOUT
      ========================= */

      .about {
        max-width: 760px;
      }

      .about p {
        font-size: 17px;
        line-height: 1.9;
      }

      /* =========================
         CONTACT
      ========================= */

      .contact {
        background: var(--accent);
        color: white;
        padding: 65px;
        border-radius: 12px;
      }

      .contact h2 {
        margin-bottom: 20px;
      }

      .contact p {
        color: #f0e2e8;
        max-width: 650px;
      }

      .contact a {
        display: inline-block;
        margin-top: 15px;
        font-size: 16px;
        font-weight: 600;
        text-decoration: underline;
        text-underline-offset: 5px;
      }

      /* =========================
         FOOTER
      ========================= */

      footer {
        padding: 35px 0;
        font-size: 13px;
        color: var(--muted);
		text-align: center;

      }

      /* =========================
         TABLET RESPONSIVENESS
      ========================= */

      @media (max-width: 850px) {
        .hero {
          grid-template-columns: 1fr;
          gap: 36px;
          padding: 65px 0;
        }

        .hero h1 {
          font-size: clamp(40px, 8vw, 62px);
        }

        .hero-image {
          justify-self: start;
          max-width: 340px;
        }
      }

      /* =========================
         MOBILE RESPONSIVENESS
      ========================= */

      @media (max-width: 650px) {
        header {
          flex-direction: column;
          align-items: flex-start;
          gap: 18px;
        }

        nav {
          gap: 16px;
        }

        .hero {
          padding: 60px 0 75px;
        }

        .hero h1 {
          font-size: clamp(38px, 9vw, 52px);
        }

        .intro {
          font-size: 16px;
        }

        .hero-image {
          width: 100%;
          max-width: 100%;
        }

        .hero-image img {
          max-height: 440px;
        }

        .cards {
          grid-template-columns: 1fr;
        }

        .card {
          padding: 24px;
        }

        .contact {
          padding: 35px 25px;
        }

        section:not(.hero) {
          padding: 55px 0;
        }
      }

      /* =========================
         ACCESSIBILITY
      ========================= */

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }

        .button,
        .card {
          transition: none;
        }

        .button:hover,
        .card:hover {
          transform: none;
        }
      }
    </style>
  </head>

  <body>
    <div class="container">

      <!-- =========================
           HEADER
      ========================= -->

      <header>
        <a class="logo" href="/">Joumana Makki</a>

        <nav aria-label="Main navigation">
          <a href="#about">About</a>
          <a href="#research">Research</a>
          <a href="/JoumanaMakki_Lebenslauf.pdf" target="_blank" rel="noopener noreferrer">CV</a>
          <a href="#contact">Contact</a>
        </nav>
      </header>

      <main>

        <!-- =========================
             HERO
        ========================= -->

        <section class="hero">

          <div class="hero-content">

            <div class="eyebrow">
              Computer Vision · Machine Learning · Research
            </div>

            <h1>
              Hello, I'm Joumana.<br />
              Exploring how machines <br />
              <em>see and learn.</em>
            </h1>

            <p class="intro">
              I'm a Data Analytics graduate and AI researcher
              interested in computer vision, representation
              learning, geometric deep learning, and
              intelligent visual systems.
            </p>

            <div class="actions">

              <a class="button" href="#research">
                Explore my research
              </a>

              <a
                class="text-link"
                href="/JoumanaMakki_Lebenslauf.pdf"
                download="JoumanaMakki_Lebenslauf"
              >
                Download CV ↓
              </a>

            </div>

          </div>

          <div class="hero-image">
            <img
              src="/images/Image2.jpg"
              alt="Portrait of Joumana Makki"
              width="370"
              height="493"
            />
          </div>

        </section>

        <!-- =========================
             RESEARCH
        ========================= -->

        <section id="research">

          <div class="eyebrow">
            01 / Selected Research
          </div>

          <h2>Research & explorations</h2>

          <div class="cards">

            {research.map((item) => (
              <article class="card">

                <span class="card-number">
                  {item.number} / {item.category}
                </span>

                <h3>{item.title}</h3>

                <p>{item.description}</p>

              </article>
            ))}

          </div>

        </section>

        <!-- =========================
             ABOUT
        ========================= -->

        <section id="about" class="about">

          <div class="eyebrow">
            02 / About Me
          </div>

          <h2>Curiosity meets computation.</h2>

          <p>
            I completed my Master's degree in Data Analytics
            at the University of Hildesheim, where I worked
            on few-shot learning, hierarchical classification,
            and hyperbolic neural networks.
          </p>

          <p>
            I enjoy connecting mathematical ideas with practical
            machine learning problems, especially in computer
            vision and representation learning.
          </p>

        </section>

        <!-- =========================
             CONTACT
        ========================= -->

        <section id="contact">

          <div class="contact">

            <div
              class="eyebrow"
              style="color: #f0d5df;"
            >
              03 / Contact
            </div>

            <h2>Let's connect.</h2>

            <p>
              I'm always interested in meaningful research
              discussions and collaborations.
            </p>

            <a href="mailto:joumana.maki@gmail.com">
              joumana.maki@gmail.com ↗
            </a>

          </div>

        </section>

      </main>
		  <a href="#" class="back-to-top" aria-label="Back to top">
  ↑
</a>
	

      <!-- =========================
           FOOTER
      ========================= -->

      <footer>

        © {new Date().getFullYear()} Joumana Makki

      </footer>

    </div>
  </body>
</html>