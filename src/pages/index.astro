---
const research = [
  {
    title: "Hierarchical Few-Shot Insect Classification",
    category: "Computer Vision · Master's Thesis",
    description: "Exploring hyperbolic representations and hierarchical learning for fine-grained insect recognition.",
    number: "01",
  },
  {
    title: "Optimization in Hyperbolic Neural Networks",
    category: "Geometric Deep Learning",
    description: "Investigating optimization methods and representations in non-Euclidean neural networks.",
    number: "02",
  },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Joumana Makki — Computer Vision and Machine Learning Researcher" />
    <title>Joumana Makki | AI Research</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />
    <style is:global>
      :root {
        --paper: #FAF8F5;
        --ink: #24242B;
        --accent: #74374F;
        --muted: #706B70;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: "DM Sans", sans-serif;
        line-height: 1.6;
      }
      a { color: inherit; text-decoration: none; }
      .container { width: min(1100px, 90%); margin: auto; }
      header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 28px 0;
        border-bottom: 1px solid #e7e0df;
      }
      .logo { font-weight: 700; letter-spacing: -.04em; }
      nav { display: flex; gap: 25px; }
      nav a, .eyebrow { font-size: 13px; }
      nav a:hover, .text-link:hover { color: var(--accent); }
      .eyebrow {
        color: var(--accent);
        font-weight: 700;
        letter-spacing: .12em;
        text-transform: uppercase;
      }
      h1, h2, h3 {
        font-family: "Instrument Serif", Georgia, serif;
        font-weight: 400;
        line-height: 1.1;
      }
      h1 { font-size: clamp(56px, 8vw, 104px); margin: 25px 0; }
      h1 em { color: var(--accent); font-weight: 400; }
      h2 { font-size: clamp(40px, 5vw, 62px); margin: 15px 0 35px; }
      h3 { font-size: 32px; margin: 12px 0; }
      p { color: var(--muted); }
      .hero { padding: 110px 0 125px; max-width: 880px; }
      .intro { font-size: 19px; max-width: 660px; }
      .actions { display: flex; gap: 22px; margin-top: 36px; align-items: center; flex-wrap: wrap; }
      .button { padding: 13px 22px; border-radius: 5px; background: var(--accent); color: white; }
      section { padding: 75px 0; }
      .cards { display: grid; grid-template-columns: repeat(2, 1fr); gap: 25px; }
      .card { border: 1px solid #e7e0df; padding: 28px; border-radius: 8px; background: #fffdfb; }
      .card-number { color: var(--accent); font-size: 13px; }
      .card p { font-size: 15px; }
      .about { max-width: 760px; }
      .contact { background: var(--accent); color: white; padding: 65px; border-radius: 10px; }
      .contact p { color: #f0e2e8; }
      footer { padding: 35px 0; font-size: 13px; color: var(--muted); }
      @media (max-width: 650px) {
        header { align-items: flex-start; gap: 18px; flex-direction: column; }
        nav { gap: 16px; flex-wrap: wrap; }
        .hero { padding: 75px 0 90px; }
        .cards { grid-template-columns: 1fr; }
        .contact { padding: 35px 25px; }
      }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
      }
    </style>
  </head>
  <body>
    <div class="container">
      <header>
        <a class="logo" href="/">JM / Joumana Makki</a>
        <nav aria-label="Main navigation">
          <a href="#about">About</a>
          <a href="#research">Research</a>
          <a href="#contact">Contact</a>
        </nav>
      </header>

      <main>
        <section class="hero">
          <div class="eyebrow">Computer Vision · Machine Learning · Research</div>
          <h1>Hello, I'm Joumana.<br />Exploring how machines <em>see and learn.</em></h1>
          <p class="intro">
            I'm a Data Analytics graduate and AI researcher interested in
            computer vision, representation learning, geometric deep
            learning, and intelligent visual systems.
          </p>
          <div class="actions">
            <a class="button" href="#research">Explore my research</a>
            <a class="text-link" href="#contact">Get in touch ↗</a>
          </div>
        </section>

        <section id="research">
          <div class="eyebrow">01 / Selected Research</div>
          <h2>Research & explorations</h2>
          <div class="cards">
            {research.map((item) => (
              <article class="card">
                <span class="card-number">{item.number} / {item.category}</span>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </article>
            ))}
          </div>
        </section>

        <section id="about" class="about">
          <div class="eyebrow">02 / About Me</div>
          <h2>Curiosity meets computation.</h2>
          <p>
            I completed my Master's degree in Data Analytics at the
            University of Hildesheim, where I worked on few-shot learning,
            hierarchical classification, and hyperbolic neural networks.
            I enjoy connecting mathematical ideas with practical machine
            learning problems.
          </p>
        </section>

        <section id="contact">
          <div class="contact">
            <div class="eyebrow" style="color:#f0d5df">03 / Contact</div>
            <h2>Let's connect.</h2>
            <p>I'm always interested in meaningful research discussions and collaborations.</p>
            <a href="mailto:joumana.maki@gmail.com">joumana.maki@gmail.com ↗</a>
          </div>
        </section>
      </main>

      <footer>© {new Date().getFullYear()} Joumana Makki · Built with Astro</footer>
    </div>
  </body>
</html>